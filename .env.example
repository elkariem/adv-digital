# Password that gates the laboratory management area (/manage).
MANAGEMENT_PASSWORD=change-me-to-a-long-random-password

# Signs the management session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-32-byte-random-hex-string

# Supabase project. Both are server-only: never rename them with a
# NEXT_PUBLIC_ prefix, and never read them from a client component.
# SUPABASE_URL is the project URL from Settings > API.
# SUPABASE_SERVICE_ROLE_KEY is the secret key from Settings > API
# (starts with sb_secret_). This key bypasses RLS, so the database grants
# access to nothing else. Keep it out of version control.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key
